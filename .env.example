# ---- Database (libSQL / SQLite — free & open source) ----
# Local dev: leave both blank, a local file "local.db" is used automatically.
# Production (Vercel/serverless): create a free database at https://turso.tech
# (Turso free tier: 500 databases, 9GB storage, no credit card required)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- AI reply engine ----
# Free tier, OpenAI-compatible, serves open-source models (Llama 3, etc).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# If GROQ_API_KEY is left blank, the app falls back to a built-in
# rule-based responder so the demo still works with zero setup.

# ---- Facebook Messenger (optional — only needed for a real Page) ----
# Create a free Meta developer app at https://developers.facebook.com
FB_PAGE_ACCESS_TOKEN=
FB_VERIFY_TOKEN=my-verify-token
FB_APP_SECRET=

# ---- Human handoff via Telegram (free bot) ----
# Create a bot for free with @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Shared secret to protect the /api/seed demo endpoint (optional)
DEMO_SECRET=
