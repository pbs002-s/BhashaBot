# Everything below is optional and can also be set from the Settings page,
# which stores it in your own database. A value saved in Settings wins; these
# variables are the fallback for anyone who would rather not put secrets in a
# database at all.

# ---- Database (libSQL / SQLite) ----
# Local dev: leave both blank and a local file "local.db" is used.
# Production: create a free database at https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Model provider ----
# Settings -> Free API keys lists every provider you can start on without a
# payment card: Groq, Google AI Studio (Gemini), Cerebras, Mistral, GitHub
# Models, OpenRouter (:free models), Together and Hugging Face.
# Free Groq key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=

# With no key at all the built-in multilingual rule engine answers instead
# (Bengali, Banglish, Hindi, Spanish and English), and it is also the automatic
# fallback whenever a model call fails.

# ---- Meta: Messenger, Instagram DM, WhatsApp Cloud ----
# https://developers.facebook.com — all three are free.
# Webhooks: /api/channels/messenger, /api/channels/instagram, /api/channels/whatsapp
FB_PAGE_ACCESS_TOKEN=
FB_VERIFY_TOKEN=my-verify-token
FB_APP_SECRET=
IG_ACCESS_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- Telegram: replies and handoff alerts ----
# Create a bot for free with @BotFather, message it once, then read the chat id
# from https://api.telegram.org/bot<token>/getUpdates
# Webhook: /api/channels/telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Discord (interactions endpoint: /api/channels/discord) ----
# https://discord.com/developers — bot token sends, public key verifies.
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=

# ---- Slack (events endpoint: /api/channels/slack) ----
# https://api.slack.com/apps — free on any workspace.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ---- Generic webhook (/api/channels/web) ----
# Anything that can POST JSON: a site widget, Zapier, n8n, Viber, LINE.
# Leave blank to accept unauthenticated posts, or set a secret and send it as
# the x-bhasha-secret header.
WEBHOOK_SECRET=

# --- Private persona mood -------------------------------------------------
# Password that unlocks the "Pritam" mood and its sub-moods in the UI.
# Leave unset and the shipped default ("pritam") applies — change it before deploying.
MOOD_PASSWORD=
# Optional: separate HMAC secret for the unlock cookie. Defaults to one derived
# from MOOD_PASSWORD, so setting it is only needed if you rotate the password
# without wanting to invalidate open sessions.
MOOD_LOCK_SECRET=
