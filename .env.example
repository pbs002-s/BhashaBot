# ---- Database (libSQL / SQLite — free & open source) ----
# Local dev: leave both blank, a local file "local.db" is used automatically.
# Production (Vercel/serverless): create a free database at https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- AI Reply Engine (Groq Llama 3.3 or OpenAI) ----
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Alternatively, OpenAI API key:
OPENAI_API_KEY=

# If AI keys are left blank, the app runs on its built-in smart multilingual
# rule engine (supports Bengali, Banglish, Hindi, Spanish, and English).

# ---- Facebook Messenger (optional — only needed for a real Meta Page) ----
# Create a free Meta developer app at https://developers.facebook.com
FB_PAGE_ACCESS_TOKEN=
FB_VERIFY_TOKEN=my-verify-token
FB_APP_SECRET=

# ---- Human Handoff via Telegram (free bot) ----
# Create a bot for free with @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
