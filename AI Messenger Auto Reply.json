    {
      "parameters": {
        "jsCode": "const body = ($input.first().json.body) || {};\nconst entry = (body.entry && body.entry[0]) || {};\nconst messaging = (entry.messaging && entry.messaging[0]) || {};\nconst msg = messaging.message || {};\nconst text = (msg.text || '').trim();\n// Ignore delivery/read/echo events and empty messages\nif (!text || msg.is_echo) { return []; }\nreturn [{ json: {\n  senderId: (messaging.sender && messaging.sender.id) || '',\n  pageId: entry.id || '',\n  messageText: text,\n  receivedAt: new Date().toISOString(),\n  startTs: Date.now(),\n} }];"
      },
      "id": "baeef23e-1fe3-4136-9cee-71d164c6a50d",
      "name": "Extract Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o",
          "cachedResultName": "gpt-4o"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are a friendly, professional Facebook Page customer support representative.\nRules:\n- Always be friendly, professional, short and helpful.\n- Never argue. Never reveal that you are an AI. Never hallucinate or invent facts.\n- If you do not know the answer, set needs_human=true and set reply to: \"I'll connect you with a human.\"\n\nLANGUAGE: Detect the user's language and ALWAYS reply in that same language.\nSupported: English, Bangla, Hindi, Urdu, Arabic, Spanish, French, German, Chinese, Japanese, Russian, Portuguese, Italian, Turkish, Malay, Indonesian, Thai, Vietnamese.\n\nBANGLA: If the user writes in Bangla or Banglish (romanized Bangla like \"kemon aso\", \"price koto\", \"order korte chai\"), reply in natural, human-sounding Bangla — NOT stiff Google-Translate Bangla.\nMatch the user's register: informal (তুমি/তোরা) vs formal (আপনি). Understand mixed Banglish.\n\nHUMAN HANDOFF: Set needs_human=true when the message involves any of: angry customer, refund, legal, complaint, abuse, order cancellation, payment failed, or an emergency. In that case do not attempt to resolve it — reply that a human will help shortly.\n\nSENTIMENT: Classify sentiment as one of: happy, neutral, confused, angry, urgent.\n\nLEAD CAPTURE: Extract any lead details the user reveals (name, phone, email, location, interest, budget, company). Leave a field as \"\" if not present.\n\nOUTPUT: Respond ONLY with a JSON object matching this exact shape:\n{\n  \"detected_language\": \"<language name>\",\n  \"language_code\": \"<ISO code, e.g. en, bn, hi>\",\n  \"reply\": \"<your reply in the user's language>\",\n  \"sentiment\": \"happy|neutral|confused|angry|urgent\",\n  \"intent\": \"<short intent label, e.g. price_inquiry, order, support, greeting>\",\n  \"needs_human\": true|false,\n  \"lead\": { \"name\": \"\", \"phone\": \"\", \"email\": \"\", \"location\": \"\", \"interest\": \"\", \"budget\": \"\", \"company\": \"\" }\n}"
            },
            {
              "content": "={{ $json.messageText }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_object"
            }
          },
          "temperature": 0.6
        }
      },
      "id": "21134209-4aec-446a-a61e-a1d7f654505f",
      "name": "AI Support Reply",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        672,
        96
      ],
      "credentials": {
        "openAiApi": {
          "id": "TvLhFZKFIvdZ7MLm",
          "name": "n8n free OpenAI API credits"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const j = items[i].json;\n  let raw = '';\n  try { raw = j.output[0].content[0].text; } catch (e) { raw = j.text || j.content || \"\"; }\n  let data = {};\n  try { data = JSON.parse(raw); } catch (e) {\n    data = { reply: \"I'll connect you with a human.\", detected_language: 'unknown', language_code: '', sentiment: 'neutral', intent: 'unknown', needs_human: true, lead: {} };\n  }\n  const lead = data.lead || {};\n  const src = ($(\"Extract Message\").all()[i] || {}).json || {};\n  out.push({ json: {\n    senderId: src.senderId || '',\n    pageId: src.pageId || '',\n    messageText: src.messageText || '',\n    reply: data.reply || \"I'll connect you with a human.\",\n    detected_language: data.detected_language || 'unknown',\n    language_code: data.language_code || '',\n    sentiment: data.sentiment || 'neutral',\n    intent: data.intent || 'unknown',\n    needs_human: data.needs_human === true,\n    lead_name: lead.name || '', lead_phone: lead.phone || '', lead_email: lead.email || '',\n    lead_location: lead.location || '', lead_interest: lead.interest || '', lead_budget: lead.budget || '', lead_company: lead.company || '',\n    latency_ms: src.startTs ? (Date.now() - src.startTs) : 0,\n    receivedAt: src.receivedAt || new Date().toISOString(),\n  } });\n}\nreturn out;"
      },
